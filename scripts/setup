#!/usr/bin/env bash
# One-shot local setup: dependencies, .env, embedded Postgres, schema, demo defaults.
# Linux / macOS. A Windows machine needs WSL2 first.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is not installed — see https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

echo "==> uv sync"
uv sync

if [ ! -f .env ]; then
  echo "==> creating .env from .env.example"
  cp .env.example .env
fi

echo "==> embedded Postgres + alembic upgrade head"
uv run python scripts/dev_db.py migrate

echo "==> writing demo defaults into .env"
uv run python - <<'PY'
import pathlib
import secrets

path = pathlib.Path(".env")
lines = path.read_text(encoding="utf-8").splitlines()

# 0.9 is calibrated only against LLM_PROVIDER=stub's confidence scale (see
# .env.example) -- only seed it when this .env is (still) using the stub;
# otherwise leave auto-send disabled (0) rather than ship a live threshold
# nobody calibrated against a real model.
current: dict[str, str] = {}
for line in lines:
    if "=" in line and not line.lstrip().startswith("#"):
        key, _, value = line.partition("=")
        current[key.strip()] = value.strip()
llm_provider = current.get("LLM_PROVIDER", "").strip().lower() or "stub"
auto_approve_default = "0.9" if llm_provider == "stub" else "0"

fill_if_blank = {
    "BACKEND_URL": "http://localhost:9000",
    "REVIEW_AUTH_SECRET": "demo",
    "REVIEW_SESSION_SECRET": secrets.token_hex(24),
    "AUTO_APPROVE_MIN_CONFIDENCE": auto_approve_default,
}
force = {"REVIEW_COOKIE_SECURE": "false"}  # local demo is plain http
out: list[str] = []
seen: set[str] = set()
for line in lines:
    if "=" in line and not line.lstrip().startswith("#"):
        key, _, value = line.partition("=")
        key = key.strip()
        if key in force:
            seen.add(key)
            out.append(f"{key}={force[key]}")
            continue
        if key in fill_if_blank:
            seen.add(key)
            if value.strip() == "":
                out.append(f"{key}={fill_if_blank[key]}")
                continue
    out.append(line)
for key, value in {**fill_if_blank, **force}.items():
    if key not in seen:
        out.append(f"{key}={value}")
path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY

cat <<'EOF'

Setup complete. .env is ready for an OFFLINE demo (LLM_PROVIDER=stub — no API key).
For real extraction: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY in .env.

Run it — four terminals:
  1. uv run python scripts/dev_db.py serve            # keep this one open
  2. uv run uvicorn stub_backend.app:app --port 9000
  3. uv run uvicorn ar_pipeline.main:app --port 8000
  4. uv run ar-pipeline ingest-eml tests/fixtures/emails/*.eml
     uv run ar-pipeline tick --repeat 3
     open http://localhost:8000/review   (log in: any name + password "demo")
EOF
