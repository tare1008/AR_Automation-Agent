DATABASE_URL=postgresql+psycopg://ar:ar@localhost:5432/ar_pipeline
TEST_DATABASE_URL=postgresql+psycopg://ar:ar@localhost:5432/ar_pipeline_test
BLOB_DIR=data/blob

# Which inbox connector `poll_inbox` uses: "graph" (Outlook/Microsoft 365)
# or "gmail". Leave both provider sections below blank to run offline via
# `ar-pipeline ingest-eml` instead of polling a real mailbox.
MAILBOX_PROVIDER=graph

# Microsoft Graph (mailbox polling)
#
# GRAPH_AUTH_MODE=app (default): client-credentials, needs a Microsoft 365
#   tenant + admin consent. Uses GRAPH_TENANT_ID/CLIENT_ID/CLIENT_SECRET and
#   SHARED_MAILBOX (the exact mailbox address to poll — any mailbox in the
#   tenant, since it's app-only).
# GRAPH_AUTH_MODE=delegated: device-code sign-in as one mailbox owner — the
#   only mode that works against a personal @outlook.com/@hotmail.com
#   account (Graph app-only permissions don't apply to consumer accounts).
#   Needs only GRAPH_CLIENT_ID (a public client — no secret). Run
#   `ar-pipeline graph-login` once to sign in; the refresh token is cached
#   at GRAPH_TOKEN_CACHE_PATH so later polls run unattended. SHARED_MAILBOX
#   is informational only in this mode — the signed-in account is the
#   mailbox, addressed via Graph's `/me`, not by name.
GRAPH_AUTH_MODE=app
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers
GRAPH_TOKEN_CACHE_PATH=data/graph_token_cache.json
SHARED_MAILBOX=

# Gmail (mailbox polling) — used when MAILBOX_PROVIDER=gmail. A Google Cloud
# OAuth client (Desktop app type) — unlike Microsoft, personal Gmail
# accounts need no organizational directory to register one. No secret-free
# option exists here the way Graph's device-code flow avoids one, but the
# "secret" is not treated as confidential by Google for this app type.
# Run `ar-pipeline gmail-login` once to sign in via a local-browser OAuth
# consent screen; the refresh token is cached at GMAIL_TOKEN_CACHE_PATH so
# later polls run unattended.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_CACHE_PATH=data/gmail_token_cache.json

# Backend delivery — blank disables the delivery job
BACKEND_URL=
BACKEND_AUTH_HEADER=

# LLM (normalization + image/scanned-PDF extraction)
#   stub      — offline: deterministic best-effort parse, no key, no network
#               (every field is a guess for the reviewer to correct) — the default
#   anthropic — real extraction, needs ANTHROPIC_API_KEY
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=

# Phase 2 auto-send: a flag-free extraction with confidence >= this value
# skips review and delivers automatically. 0 = review everything (Phase 1).
# WARNING: 0.9 here is calibrated ONLY against LLM_PROVIDER=stub's confidence
# scale (which only ever emits 0.2-0.95 in fixed steps). If you switch to
# LLM_PROVIDER=anthropic, a real model's confidence is not the same scale —
# set this back to 0 until you've checked real confidence values against
# these checkpoints for your own data.
AUTO_APPROVE_MIN_CONFIDENCE=0.9

# Review UI
REVIEW_AUTH_SECRET=
REVIEW_SESSION_SECRET=
REVIEW_COOKIE_SECURE=true
